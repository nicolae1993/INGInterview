pipeline {
    agent any

    stages {

        stage('Ansible Syntax Check') {
            steps {
                sh '''
                    ansible-playbook \
                        -i jenkins/ansible/inventory.ini \
                        --syntax-check \
                        jenkins/ansible/deploy.yml

                    ansible-playbook \
                        -i jenkins/ansible/inventory.ini \
                        --syntax-check \
                        jenkins/ansible/health-check.yml
                '''
            }
        }

        stage('Ansible Lint') {
            steps {
                sh '''
                    ansible-lint jenkins/ansible/deploy.yml
                    ansible-lint jenkins/ansible/health-check.yml
                '''
            }
        }

        stage('Ansible Connectivity Test') {
            steps {
                sshagent(['ansible-ssh-key']) {
                    withCredentials([
                        string(
                            credentialsId: 'ansible-vault-password',
                            variable: 'VAULT_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set +x

                            printf '%s\\n' "$VAULT_PASSWORD" > "$WORKSPACE/.vault_pass"
                            chmod 600 "$WORKSPACE/.vault_pass"

                            ansible \
                                -i jenkins/ansible/inventory.ini \
                                webservers \
                                -m ping \
                                --vault-password-file "$WORKSPACE/.vault_pass"

                            rm -f "$WORKSPACE/.vault_pass"
                        '''
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                sshagent(['ansible-ssh-key']) {
                    withCredentials([
                        string(
                            credentialsId: 'ansible-vault-password',
                            variable: 'VAULT_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set +x

                            printf '%s\\n' "$VAULT_PASSWORD" > "$WORKSPACE/.vault_pass"
                            chmod 600 "$WORKSPACE/.vault_pass"

                            ansible-playbook \
                                -i jenkins/ansible/inventory.ini \
                                jenkins/ansible/health-check.yml \
                                --vault-password-file "$WORKSPACE/.vault_pass"

                            rm -f "$WORKSPACE/.vault_pass"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh '''
                rm -f "$WORKSPACE/.vault_pass"
            '''
        }

        success {
            echo 'CI pipeline completed successfully.'
        }

        failure {
            echo 'CI pipeline failed.'
        }
    }
}
